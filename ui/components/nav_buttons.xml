<!-- Recreates screen_buttons.c: two physical-button-mapped touch buttons
     pinned to the bottom-left and bottom-right of the screen. Press state
     and label text are driven from firmware (button presses / task context)
     so they're left blank here, matching the device's default state. -->
<component>
	<view extends="lv_obj" width="480" height="272" style_bg_opa="0" style_border_width="0" style_pad_all="0">
		<lv_button name="left_button" align="top_left" x="10" y="210" width="130" height="40">
			<style name="style_nav_button" />
			<style name="style_nav_button_pressed" selector="pressed" />
			<lv_label name="left_label" align="center" y="-5" text="">
				<style name="style_nav_button_label_pressed" selector="pressed" />
			</lv_label>
		</lv_button>

		<lv_button name="right_button" align="top_left" x="260" y="210" width="130" height="40">
			<style name="style_nav_button" />
			<style name="style_nav_button_pressed" selector="pressed" />
			<lv_label name="right_label" align="center" y="-5" text="">
				<style name="style_nav_button_label_pressed" selector="pressed" />
			</lv_label>
		</lv_button>
	</view>
</component>
